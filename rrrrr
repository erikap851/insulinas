function AIFoodScanner({ apiKey, onScanComplete, onBack }) {
    const [analyzing, setAnalyzing] = useState(false);
    const [logs, setLogs] = useState([]);
    const fileInputRef = useRef(null);
    const galleryInputRef = useRef(null);

    const addLog = (msg) => setLogs(prev => [...prev, `> ${msg}`]);

    const discoverAndAnalyze = async (file) => {
        const base64DataWithHeader = await fileToBase64(file);
        const base64Data = base64DataWithHeader.split(',')[1];
        const mimeType = file.type || "image/jpeg";

        addLog("Ieškau prieinamų modelių...");
        const listResponse = await fetch(`https://generativelanguage.googleapis.com/v1beta/models?key=${apiKey.trim()}`, { method: 'GET' });
        
        if (!listResponse.ok) {
            throw new Error(`Nepavyko gauti modelių sąrašo (${listResponse.status}). Patikrinkite raktą.`);
        }

        const listData = await listResponse.json();
        
        const availableModels = listData.models || [];
        const usableModel = availableModels.find(m => 
            m.name.includes("gemini") && 
            m.supportedGenerationMethods && 
            m.supportedGenerationMethods.includes("generateContent") &&
            (m.name.includes("flash") || m.name.includes("pro"))
        );

        if (!usableModel) {
            throw new Error("Jūsų raktas neturi prieigos prie jokių Gemini modelių su vaizdo atpažinimu.");
        }

        const modelName = usableModel.name; 
        addLog(`Rastas modelis: ${modelName.replace("models/", "")}`);

        const payload = {
            contents: [{
                parts: [
                    { text: `Identify food items in this image for a Type 1 Diabetic. 
                    Return a JSON object with this exact schema, do not wrap in markdown code blocks:
                    { 
                        "summary": "Aprašymas lietuviškai, BŪTINAI nurodant apytikslį svorį gramais arba kiekį (pvz. 'Apie 200g bulvių košės ir 150g vištienos krūtinėlės').",
                        "items": [ 
                            { "name": "Name (in Lithuanian)", "carbs_g": { "min": 10, "max": 15 }, "protein_g": { "min": 5, "max": 8 }, "fat_g": { "min": 2, "max": 5 }, "portion_assumption": "1 slice", "confidence": 0.9 } 
                        ] 
                    }` 
                    },
                    { inlineData: { mimeType: mimeType, data: base64Data } }
                ]
            }],
            generationConfig: { responseMimeType: "application/json" }
        };

        addLog("Siunčiama nuotrauka...");
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/${modelName}:generateContent?key=${apiKey.trim()}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            const err = await response.json();
            throw new Error(`Klaida analizuojant (${response.status}): ${err.error?.message}`);
        }

        const data = await response.json();
        const textResponse = data.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!textResponse) throw new Error("Gautas tuščias atsakymas.");

        return JSON.parse(textResponse.replace(/```json/g, "").replace(/```/g, "").trim());
    };

    const handleFile = async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        
        setAnalyzing(true);
        setLogs([]); 
        addLog(`Failas: ${file.name}`);

        try {
            let result;
            if (apiKey && apiKey.length > 10) {
                result = await discoverAndAnalyze(file);
                addLog("SĖKMĖ! Duomenys gauti.");
            } else {
                addLog("Nėra rakto. Demo režimas.");
                result = await mockAIAnalysis();
            }
            const normalized = normalizeFoodItems(result);
            onScanComplete(normalized, result.summary);
        } catch (err) { 
            console.error(err);
            addLog(`KRITINĖ KLAIDA: ${err.message}`);
        } finally { 
            setAnalyzing(false); 
        }
    };

    return (
        <div className="h-full flex flex-col items-center justify-center space-y-6 animate-in fade-in slide-in-from-bottom-8">
            <div className="text-center space-y-2">
                <div className="w-20 h-20 bg-indigo-500/20 text-indigo-400 rounded-full flex items-center justify-center mx-auto mb-4 animate-pulse"><Search size={32} /></div>
                <h2 className="text-2xl font-bold text-white">Išmanioji AI Analizė</h2>
                <p className="text-slate-400 max-w-[250px] mx-auto text-sm">
                    {apiKey ? "Smart Model Discovery" : "Demonstracinis režimas"}
                </p>
            </div>
            
            <input type="file" accept="image/*" capture="environment" className="hidden" ref={fileInputRef} onChange={handleFile}/>
            <input type="file" accept="image/jpeg, image/png, image/webp" className="hidden" ref={galleryInputRef} onChange={handleFile}/>
            
            <div className="flex flex-col gap-3 w-full max-w-xs">
                <button 
                    onClick={() => fileInputRef.current.click()} 
                    disabled={analyzing}
                    className={`w-full py-4 rounded-2xl font-bold text-white transition flex items-center justify-center gap-2 ${analyzing ? 'bg-slate-700 cursor-not-allowed' : 'bg-indigo-600 hover:bg-indigo-500'}`}
                >
                    <Camera size={20} />
                    {analyzing ? 'Analizuojama...' : 'Fotografuoti'}
                </button>

                <button 
                    onClick={() => galleryInputRef.current.click()} 
                    disabled={analyzing}
                    className="w-full py-4 rounded-2xl font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 transition flex items-center justify-center gap-2"
                >
                    <ImageIcon size={20} />
                    Galerija
                </button>

                <button onClick={onBack} className="w-full py-4 text-slate-500 font-semibold hover:text-slate-300 transition">Atšaukti</button>
            </div>

            <div className="w-full max-w-xs bg-slate-950 rounded-lg p-3 border border-slate-800 font-mono text-[10px] text-slate-400 h-32 overflow-y-auto">
                <div className="flex items-center gap-1 text-slate-600 mb-1 border-b border-slate-900 pb-1">
                    <Terminal size={10} /> 
                    <span>Sistemos žurnalas</span>
                </div>
                {logs.length === 0 ? (
                    <span className="text-slate-700 italic">Laukiama veiksmo...</span>
                ) : (
                    logs.map((log, i) => <div key={i} className={log.includes("KLAIDA") ? "text-red-400" : log.includes("Rastas") ? "text-emerald-400" : "text-green-400"}>{log}</div>)
                )}
            </div>
        </div>
    );
}


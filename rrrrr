/* ===============================================
   DATA FETCHING (GLUCOSE)
   =============================================== */
const NS_TREND_MAP = {
    'DoubleUp': 4, 'SingleUp': 2, 'FortyFiveUp': 2, 'Flat': 0,
    'FortyFiveDown': -2, 'SingleDown': -2, 'DoubleDown': -4, 'NONE': 0,
    'doubleup': 4, 'singleup': 2, 'fortyfiveup': 2, 'flat': 0,
    'fortyfivedown': -2, 'singledown': -2, 'doubledown': -4
};

async function fetchGlucoseData(mode, url, currentBg, currentTimestamp) {
    let endpoint = "";
    const cacheBuster = `&_=${Date.now()}`;
    const count = 36; 
    
    if (mode === 'xdrip_local') {
        endpoint = `http://127.0.0.1:17580/sgv.json?count=${count}${cacheBuster}`; 
    } else {
        const cleanUrl = url ? url.replace(/\/$/, "") : "";
        if (!cleanUrl) return null;
        endpoint = `${cleanUrl}/api/v1/entries/sgv.json?count=${count}${cacheBuster}`;
    }

    try {
        const response = await fetch(endpoint, { method: 'GET' });
        if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);
        
        const data = await response.json();
        if (!data || data.length === 0) throw new Error("Gauti tušti duomenys");

        const latest = data[0];
        const previous = data[1];
        
        let bg = Number(latest.sgv);
        let delta = null;
        const latestTimestamp = latest.date || new Date(latest.dateString).getTime();

        if (previous && previous.sgv) {
            delta = bg - Number(previous.sgv);
        } else if (latest.delta) {
            delta = Number(latest.delta);
        } else if (currentBg && currentTimestamp) {
            const timeDiff = latestTimestamp - currentTimestamp;
            if (timeDiff > 180000 && timeDiff < 420000) { 
                delta = bg - currentBg;
            }
        }

        const isMgDl = bg > 30;
        const convert = (val) => isMgDl ? val / 18 : val;

        bg = convert(bg);
        if (delta !== null) delta = convert(delta);

        const history = data.map(d => ({
            val: convert(Number(d.sgv)),
            date: d.date || new Date(d.dateString).getTime()
        })).reverse(); 

        let dirString = latest.direction || 'NONE';
        let trend = NS_TREND_MAP[dirString] || NS_TREND_MAP[dirString.toLowerCase()] || 0;

        if (delta !== null) {
            if (trend === 0 || (trend > 0 && delta < -0.5) || (trend < 0 && delta > 0.5)) {
                if (delta >= 1.5) trend = 4;        
                else if (delta >= 0.5) trend = 2;   
                else if (delta <= -1.5) trend = -4; 
                else if (delta <= -0.5) trend = -2; 
                else trend = 0;                     
            }
        }

        const minutesAgo = (Date.now() - latestTimestamp) / 60000;

        return { 
            bg: round(bg, 1), 
            trend: trend, 
            delta: delta !== null ? round(delta, 2) : null,
            minutesAgo: Math.round(minutesAgo),
            timestamp: latestTimestamp,
            history: history 
        };
    } catch (error) {
        console.warn("Glucose fetch error:", error);
        return null;
    }
}

/* ===============================================
   REACT APP COMPONENTS
   =============================================== */

export default function App() {
    const [view, setView] = useState('calculator'); 
    const [showDisclaimer, setShowDisclaimer] = useState(true);

    const [settings, setSettings] = useState({
        target: 5.5, 
        dataSource: 'xdrip_local', 
        nightscoutUrl: '',
        geminiKey: '',
        profiles: DEFAULT_PROFILES
    });

    const [inputs, setInputs] = useState({
        bg: 6.5,
        trend: 0, 
        delta: null, 
        carbs: 0,
        protein: 0,
        fat: 0
    });

    const [savedMeals, setSavedMeals] = useState([]);
    const [aiSummary, setAiSummary] = useState(null);
    const [chartData, setChartData] = useState([]); 

    const [lastDataTimestamp, setLastDataTimestamp] = useState(null);
    const [connectionStatus, setConnectionStatus] = useState('idle'); 
    const [lastSyncTime, setLastSyncTime] = useState(null);
    const [bolusHistory, setBolusHistory] = useState([]);
    const [iob, setIob] = useState(0);
    const [calculationResult, setCalculationResult] = useState(null);

    // Kiosk/Env Checks
    const [mixedContentWarning, setMixedContentWarning] = useState(false);

    useEffect(() => {
        // Check for HTTPS + Localhost conflict (Common on tiiny.host)
        if (window.location.protocol === 'https:' && settings.dataSource === 'xdrip_local') {
            setMixedContentWarning(true);
        } else {
            setMixedContentWarning(false);
        }
    }, [settings.dataSource]);

    useEffect(() => {
        const saved = localStorage.getItem('diabetes-core-data-v21');
        if (saved) {
            try {
                const data = JSON.parse(saved);
                const loadedSettings = data.settings || settings;
                
                if (loadedSettings.profiles) {
                    loadedSettings.profiles = loadedSettings.profiles.map((p, i) => ({
                        ...p,
                        IconName: p.IconName || (DEFAULT_PROFILES[i] ? DEFAULT_PROFILES[i].IconName : 'Moon')
                    }));
                } else {
                    loadedSettings.profiles = DEFAULT_PROFILES;
                }
                
                if (!loadedSettings.geminiKey) loadedSettings.geminiKey = ''; 
                setSettings(loadedSettings);
                setBolusHistory(data.history || []);
                setSavedMeals(data.savedMeals || []);
            } catch (e) {
                console.error("Error loading saved data", e);
            }
        }
    }, []);

    useEffect(() => {
        const settingsToSave = { ...settings };
        localStorage.setItem('diabetes-core-data-v21', JSON.stringify({
            settings: settingsToSave,
            history: bolusHistory,
            savedMeals: savedMeals
        }));
    }, [settings, bolusHistory, savedMeals]);

    useEffect(() => {
        const updateIOB = () => {
            setIob(round(calculateIOB(bolusHistory), 2));
        };
        updateIOB();
        const interval = setInterval(updateIOB, 60000);
        return () => clearInterval(interval);
    }, [bolusHistory]);

    const handleFetchData = useCallback(async () => {
        if (settings.dataSource === 'nightscout' && !settings.nightscoutUrl) return;
        setConnectionStatus('loading');
        const data = await fetchGlucoseData(
            settings.dataSource, 
            settings.nightscoutUrl, 
            inputs.bg, 
            lastDataTimestamp
        );
        if (data) {
            setInputs(prev => ({ ...prev, bg: data.bg, trend: data.trend, delta: data.delta }));
            setLastSyncTime(data.minutesAgo);
            setLastDataTimestamp(data.timestamp);
            if (data.history) setChartData(data.history);
            setConnectionStatus('success');
        } else {
            setConnectionStatus('error');
        }
    }, [settings.dataSource, settings.nightscoutUrl, inputs.bg, lastDataTimestamp]);

    useEffect(() => {
        if ((settings.dataSource === 'nightscout' && settings.nightscoutUrl) || settings.dataSource === 'xdrip_local') {
            handleFetchData();
        }
        const poll = setInterval(handleFetchData, 60000);
        return () => clearInterval(poll);
    }, [handleFetchData, settings.dataSource, settings.nightscoutUrl]);

    const handleCalculate = () => {
        const hour = new Date().getHours();
        const activeProfile = getProfileForHour(hour, settings.profiles);
        const bgValue = parseFloat(inputs.bg) || 0;
        
        const carbBolus = inputs.carbs / activeProfile.icr;
        const proteinCarbs = proteinToCarbs(inputs.protein, hour);
        const proteinBolus = proteinCarbs / activeProfile.icr;
        const correction = (bgValue - settings.target) / activeProfile.isf;
        const trendAdj = trendCorrection(inputs.trend);
        
        let immediateGross = carbBolus + correction + trendAdj;
        let immediateNet = immediateGross - iob;
        let remainingIOB = 0;

        if (immediateNet < 0) {
            remainingIOB = Math.abs(immediateNet);
            immediateNet = 0;
        }

        let extendedNet = proteinBolus - remainingIOB;
        if (extendedNet < 0) extendedNet = 0;

        setCalculationResult({
            activeProfileName: activeProfile.label,
            activeICR: activeProfile.icr,
            activeISF: activeProfile.isf,
            carbBolus,
            proteinBolus,
            correction,
            trendAdj,
            iobDeduction: iob,
            immediate: round(immediateNet, 1),
            extended: round(extendedNet, 1),
            total: round(immediateNet + extendedNet, 1),
            gross: round(immediateGross + proteinBolus, 1),
            proteinCarbEquiv: round(proteinCarbs, 1)
        });
        
        setView('result');
    };

    const confirmBolus = (units, customTime = Date.now()) => {
        const newEntry = { 
            id: Math.random().toString(36).substr(2, 9),
            time: customTime, 
            units: parseFloat(units), 
            type: 'bolus' 
        };
        setBolusHistory(prev => [newEntry, ...prev]);
        setInputs(prev => ({ ...prev, carbs: 0, protein: 0, fat: 0 }));
        setAiSummary(null); 
        setView('calculator');
    };

    const deleteHistoryItem = (id) => {
        if (window.confirm("Ar tikrai ištrinti šį įrašą?")) {
            setBolusHistory(prev => prev.filter(item => item.id !== id));
        }
    };

    const handleAIResult = (items, summary) => {
        const totalCarbs = items.reduce((acc, item) => acc + item.carbsSelected, 0);
        const totalProtein = items.reduce((acc, item) => acc + item.proteinSelected, 0);
        setInputs(prev => ({ ...prev, carbs: Math.round(totalCarbs), protein: Math.round(totalProtein) }));
        setAiSummary(summary); 
        setView('calculator');
    };

    const saveMeal = () => {
        const name = prompt("Įveskite šio patiekalo pavadinimą:");
        if (name) {
            const newMeal = {
                id: Date.now().toString(),
                name,
                carbs: inputs.carbs,
                protein: inputs.protein
            };
            setSavedMeals(prev => [...prev, newMeal]);
        }
    };

    const loadMeal = (meal) => {
        setInputs(prev => ({ ...prev, carbs: meal.carbs, protein: meal.protein }));
    };

    const deleteMeal = (e, id) => {
        e.stopPropagation();
        if(window.confirm("Ištrinti šį patiekalą?")) {
            setSavedMeals(prev => prev.filter(m => m.id !== id));
        }
    };

    if (showDisclaimer) return (
        <>
            <KioskStyles />
            <div className="bg-slate-950 text-slate-100 min-h-screen font-sans">
                 <DisclaimerScreen onAccept={() => setShowDisclaimer(false)} />
            </div>
        </>
    );

    return (
        <>
            <KioskStyles />
            <div className="bg-slate-950 text-slate-100 font-sans selection:bg-teal-500/30 min-h-screen">
                <div className="max-w-md mx-auto min-h-screen flex flex-col relative pb-20">
                    
                    {/* Header with Safe Area Support for OnePlus 11 Notch */}
                    <header className="px-6 pt-[calc(2rem+env(safe-area-inset-top))] pb-4 flex justify-between items-end bg-gradient-to-b from-slate-900 to-slate-950 sticky top-0 z-10">
                        <div>
                            <h1 className="text-xl font-bold tracking-tight text-teal-400">DIABETES CORE</h1>
                            <div className="text-xs text-slate-500 font-mono mt-1">v7.2 Kiosk • IOB: {formatNum(iob)} U</div>
                        </div>
                        <div className="flex gap-2">
                            <button onClick={() => setView('history')} className={`p-2 rounded-full transition ${view === 'history' ? 'bg-teal-500 text-slate-900' : 'bg-slate-800 text-slate-400 hover:bg-slate-700'}`}>
                                <Clock size={20} />
                            </button>
                            <button onClick={() => setView('settings')} className={`p-2 rounded-full transition relative ${view === 'settings' ? 'bg-teal-500 text-slate-900' : 'bg-slate-800 text-slate-400 hover:bg-slate-700'}`}>
                                <Settings size={20} />
                                {settings.dataSource === 'nightscout' && !settings.nightscoutUrl && (
                                <span className="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-slate-900"></span>
                                )}
                            </button>
                        </div>
                    </header>

                    {/* Mixed Content Warning for tiiny.host */}
                    {mixedContentWarning && (
                        <div className="px-6 pb-2">
                            <div className="bg-red-500/10 border border-red-500/30 rounded-lg p-3 flex items-start gap-2">
                                <ShieldAlert size={16} className="text-red-500 shrink-0 mt-0.5" />
                                <div className="text-[10px] text-red-300">
                                    <strong className="block text-red-400 mb-1">Ryšio Klaida (HTTPS)</strong>
                                    Jūs esate saugioje svetainėje, bet bandote pasiekti telefoną nesaugiu (HTTP) būdu. Fully Kiosk nustatymuose įjunkite: 
                                    <span className="block mt-1 font-mono bg-red-950/50 p-1 rounded">Settings {'>'} Web Content {'>'} Mixed Content Mode {'>'} Always Allow</span>
                                </div>
                            </div>
                        </div>
                    )}

                    <main className="flex-1 px-6">
                        {view === 'calculator' && (
                            <CalculatorView 
                                inputs={inputs} 
                                setInputs={setInputs} 
                                onCalculate={handleCalculate}
                                onOpenAI={() => setView('ai')}
                                settings={settings}
                                connectionStatus={connectionStatus}
                                lastSyncTime={lastSyncTime}
                                onRefresh={handleFetchData} 
                                aiSummary={aiSummary}
                                chartData={chartData}
                                savedMeals={savedMeals}
                                onSaveMeal={saveMeal}
                                onLoadMeal={loadMeal}
                                onDeleteMeal={deleteMeal}
                            />
                        )}
                        {view === 'settings' && (
                            <SettingsView 
                                settings={settings} 
                                setSettings={setSettings} 
                                onBack={() => setView('calculator')} 
                            />
                        )}
                        {view === 'ai' && (
                            <AIFoodScanner 
                                apiKey={settings.geminiKey}
                                onScanComplete={handleAIResult} 
                                onBack={() => setView('calculator')}
                            />
                        )}
                        {view === 'history' && (
                            <HistoryView 
                                history={bolusHistory} 
                                onDelete={deleteHistoryItem}
                                onBack={() => setView('calculator')}
                            />
                        )}
                        {view === 'result' && calculationResult && (
                            <ResultView 
                                result={calculationResult} 
                                onConfirm={confirmBolus} 
                                onCancel={() => setView('calculator')}
                            />
                        )}
                    </main>
                </div>
            </div>
        </>
    );
}

/* ===============================================
   CHART COMPONENT
   =============================================== */

function GlucoseChart({ data, target }) {
    if (!data || data.length < 2) return null;

    const height = 60;
    const width = 300;
    const padding = 5;

    const minVal = Math.min(...data.map(d => d.val), 3.5);
    const maxVal = Math.max(...data.map(d => d.val), 12);
    const timeSpan = data[data.length - 1].date - data[0].date;

    const getX = (date) => ((date - data[0].date) / timeSpan) * (width - 2 * padding) + padding;
    const getY = (val) => height - ((val - minVal) / (maxVal - minVal)) * (height - 2 * padding) - padding;

    const points = data.map(d => `${getX(d.date)},${getY(d.val)}`).join(' ');
    const targetY = getY(target);

    return (
        <div className="w-full h-20 bg-slate-900/30 rounded-lg mt-4 relative overflow-hidden">
            <svg width="100%" height="100%" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none">
                <line x1="0" y1={targetY} x2={width} y2={targetY} stroke="rgba(20, 184, 166, 0.2)" strokeWidth="1" strokeDasharray="4 2" />
                <polyline 
                    points={points} 
                    fill="none" 
                    stroke="rgba(20, 184, 166, 0.6)" 
                    strokeWidth="2" 
                    strokeLinecap="round" 
                    strokeLinejoin="round" 
                />
                <polygon 
                    points={`${points} ${width},${height} 0,${height}`} 
                    fill="rgba(20, 184, 166, 0.1)" 
                />
            </svg>
            <div className="absolute top-1 left-2 text-[8px] text-slate-600 font-mono">3 val. istorija</div>
        </div>
    );
}


/* ===============================================
   SUB-COMPONENTS

function HistoryView({ history, onDelete, onBack }) {
    const sortedHistory = [...history].sort((a, b) => b.time - a.time);
    
    const exportCSV = () => {
        let csvContent = "data:text/csv;charset=utf-8,";
        csvContent += "Data,Laikas,Vienetai,Tipas,ID\n"; 
        
        sortedHistory.forEach(item => {
            const date = new Date(item.time);
            const dateStr = date.toLocaleDateString('lt-LT');
            const timeStr = date.toLocaleTimeString('lt-LT');
            const row = `${dateStr},${timeStr},${item.units},${item.type},${item.id}`;
            csvContent += row + "\n";
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `diabetes_history_${new Date().toLocaleDateString('lt-LT')}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    const grouped = sortedHistory.reduce((acc, item) => {
        const date = new Date(item.time).toLocaleDateString('lt-LT');
        if (!acc[date]) acc[date] = [];
        acc[date].push(item);
        return acc;
    }, {});

    return (
        <div className="space-y-6 animate-in slide-in-from-right duration-300">
            <div className="flex justify-between items-center mb-6">
                <div className="flex items-center gap-2 cursor-pointer" onClick={onBack}>
                    <div className="bg-slate-800 p-2 rounded-lg rotate-180"><ChevronRight size={20} /></div>
                    <span className="font-bold text-lg">Istorija</span>
                </div>
                {sortedHistory.length > 0 && (
                    <button onClick={exportCSV} className="flex items-center gap-1 bg-slate-800 hover:bg-slate-700 text-teal-400 text-xs px-3 py-2 rounded-lg transition font-medium">
                        <Download size={14} /> CSV
                    </button>
                )}
            </div>

            {sortedHistory.length === 0 ? (
                <div className="text-center text-slate-500 py-10">
                    <Clock size={48} className="mx-auto mb-4 opacity-20" />
                    <p>Nėra įrašų</p>
                </div>
            ) : (
                Object.keys(grouped).map(date => (
                    <div key={date}>
                        <div className="flex items-center gap-2 mb-3 mt-6">
                            <Calendar size={14} className="text-teal-500" />
                            <span className="text-xs font-bold text-teal-500 uppercase tracking-wider">{date}</span>
                        </div>
                        <div className="space-y-2">
                            {grouped[date].map(item => {
                                const minAgo = (Date.now() - item.time) / 60000;
                                const isActive = minAgo < IOB_CONFIG.duration;
                                
                                return (
                                    <div key={item.id || item.time} className={`bg-slate-900 border rounded-xl p-3 flex justify-between items-center ${isActive ? 'border-teal-500/30 bg-teal-500/5' : 'border-slate-800'}`}>
                                        <div className="flex items-center gap-3">
                                            <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm ${isActive ? 'bg-teal-500 text-slate-900' : 'bg-slate-800 text-slate-400'}`}>
                                                {formatNum(item.units)}
                                            </div>
                                            <div>
                                                <div className="font-mono text-sm text-white">

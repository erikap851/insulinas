                        className="bg-transparent text-white font-mono text-sm w-full focus:outline-none pr-16"
                    />
                    <div className="flex items-center gap-2 absolute right-2 text-slate-400">
                        {settings.geminiKey && (
                            <button onClick={() => handleChange('geminiKey', '')} className="hover:text-red-400">
                                <XCircle size={16} />
                            </button>
                        )}
                        <button onClick={() => setShowKey(!showKey)} className="hover:text-white">
                            {showKey ? <EyeOff size={16} /> : <Eye size={16} />}
                        </button>
                    </div>
                </div>
                
                <div className="flex items-start gap-2 mt-3 bg-slate-800/50 p-2 rounded text-[10px] text-slate-400">
                    <Globe size={12} className="shrink-0 mt-0.5" />
                    <p>Sistema pati suras geriausią veikiantį modelį jūsų raktui.</p>
                </div>
            </div>

            <div className="space-y-3">
                <label className="text-xs font-bold text-slate-500 uppercase px-1">Valandiniai Profiliai</label>
                {settings.profiles.map((profile, idx) => {
                    const ProfileIcon = iconMap[profile.IconName] || Moon;
                    return (
                        <div key={profile.id} className="bg-slate-900 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-2">
                            <div className="flex items-center gap-2 w-28 text-slate-300 text-sm font-medium">
                                <ProfileIcon size={14} />
                                <span className="truncate">{profile.label}</span>
                            </div>
                            <div className="flex gap-2">
                                <div className="flex flex-col items-end">
                                    <span className="text-[9px] text-slate-500 uppercase">ICR</span>
                                    <input type="number" className="w-12 bg-slate-950 rounded p-1 text-center font-mono text-white text-sm focus:outline-none border border-slate-700 focus:border-teal-500"
                                        value={profile.icr} onChange={(e) => handleProfileChange(idx, 'icr', e.target.value)} />
                                </div>
                                <div className="flex flex-col items-end">
                                    <span className="text-[9px] text-slate-500 uppercase">ISF</span>
                                    <input type="number" className="w-12 bg-slate-950 rounded p-1 text-center font-mono text-white text-sm focus:outline-none border border-slate-700 focus:border-teal-500"
                                        value={profile.isf} onChange={(e) => handleProfileChange(idx, 'isf', e.target.value)} />
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>

            <div className="bg-slate-900 p-4 rounded-xl border border-slate-800 mt-4">
                <label className="block text-xs font-bold text-slate-500 uppercase mb-3">Duomenų šaltinis</label>
                <div className="grid grid-cols-2 gap-2">
                    <button onClick={() => handleChange('dataSource', 'xdrip_local')} className={`p-3 rounded-lg text-sm font-semibold flex items-center justify-center gap-2 transition ${settings.dataSource === 'xdrip_local' ? 'bg-teal-500 text-white' : 'bg-slate-800 text-slate-400'}`}>
                        <Smartphone size={16} /> xDrip
                    </button>
                    <button onClick={() => handleChange('dataSource', 'nightscout')} className={`p-3 rounded-lg text-sm font-semibold flex items-center justify-center gap-2 transition ${settings.dataSource === 'nightscout' ? 'bg-indigo-500 text-white' : 'bg-slate-800 text-slate-400'}`}>
                        <Cloud size={16} /> Cloud
                    </button>
                </div>
                {settings.dataSource === 'nightscout' && (
                    <input type="text" value={settings.nightscoutUrl} onChange={(e) => handleChange('nightscoutUrl', e.target.value)} placeholder="https://..." className="mt-3 bg-slate-950/50 rounded-lg p-2 text-white font-mono text-sm w-full focus:outline-none border border-slate-700"/>
                )}
            </div>

            <div className="bg-slate-900 p-4 rounded-xl border border-slate-800">
                <label className="block text-xs font-bold text-slate-500 uppercase mb-2">Tikslinė gliukozė</label>
                <div className="flex items-center gap-2">
                    <input type="number" value={settings.target} onChange={(e) => handleChange('target', e.target.value)} className="bg-transparent text-white font-mono text-2xl w-full focus:outline-none"/>
                    <span className="text-slate-600 text-sm">mmol/L</span>
                </div>
            </div>
        </div>
    );
}

function DisclaimerScreen({ onAccept }) {
    return (
        <div className="min-h-screen bg-slate-950 flex items-center justify-center p-6 text-center">
            <div className="max-w-sm space-y-6">
                <div className="w-16 h-16 bg-red-500/10 text-red-500 rounded-full flex items-center justify-center mx-auto"><AlertTriangle size={32} /></div>
                <h1 className="text-2xl font-bold text-white">Saugumo Įspėjimas</h1>
                <p className="text-slate-400 text-sm leading-relaxed">Tai rekomendacija. Galutinį sprendimą priima vartotojas.<br/><br/>Visada patikrinkite skaičiavimus.</p>
                <button onClick={onAccept} className="w-full py-3 bg-red-600 hover:bg-red-500 text-white rounded-xl font-bold transition">Suprantu</button>
            </div>
        </div>
    );
}

/* ===============================================
   CORE LOGIC & CONFIG
   =============================================== */

const IOB_CONFIG = {
    onset: 20,     // min
    peak: 75,
    duration: 240
};

const DEFAULT_PROFILES = [
    { id: 'night',   label: 'Naktis (00-06)', start: 0,  icr: 12, isf: 2.5, IconName: 'Moon' },
    { id: 'morning', label: 'Rytas (06-11)',  start: 6,  icr: 8,  isf: 2.0, IconName: 'Sunrise' },
    { id: 'day',     label: 'Diena (11-17)',  start: 11, icr: 10, isf: 2.2, IconName: 'Sun' },
    { id: 'evening', label: 'Vakaras (17-23)',start: 17, icr: 11, isf: 2.3, IconName: 'Sunset' }
];

const iconMap = {
    Moon, Sunrise, Sun, Sunset
};

function getProfileForHour(hour, profiles) {
    const sorted = [...profiles].sort((a, b) => b.start - a.start);
    return sorted.find(p => hour >= p.start) || sorted[0];
}

function insulinActivity(minutes) {
    const { onset, peak, duration } = IOB_CONFIG;
    if (minutes <= onset) return 0;
    if (minutes <= peak)
        return (minutes - onset) / (peak - onset);
    if (minutes <= duration)
        return 1 - (minutes - peak) / (duration - peak);
    return 0;
}

function calculateIOB(bolusHistory, now = Date.now()) {
    return bolusHistory.reduce((sum, b) => {
        const minAgo = (now - b.time) / 60000;
        if (minAgo > IOB_CONFIG.duration) return sum;
        return sum + b.units * insulinActivity(minAgo);
    }, 0);
}

const PROTEIN_CONFIG = {
    dayFactor: 0.25,
    nightFactor: 0.35
};

function proteinToCarbs(proteinGrams, hour) {
    const isNight = hour >= 22 || hour < 6;
    const factor = isNight ? PROTEIN_CONFIG.nightFactor : PROTEIN_CONFIG.dayFactor;
    return proteinGrams * factor;
}

function trendCorrection(trendMmolPerMin) {
    const impact = trendMmolPerMin * 0.5;
    return Math.max(-2, Math.min(2, impact));
}

function round(value, precision = 1) {
    const factor = Math.pow(10, precision);
    return Math.round(value * factor) / factor;
}

function formatNum(value) {
    if (value === null || value === undefined || isNaN(value)) return '';
    return Number(value).toFixed(1);
}

